{
  "name": "silent-depths-lookdev",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Silent Depths look-development lab — ocean, atmosphere, and presentation tuning",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8080",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 8080 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check \"scripts/**/*.mjs\" \"tests/replay.test.ts\" \"tests/e2e/**/*.{mjs,js,ts}\" \"eslint.config.js\" \".prettierrc\" \"package.json\" \"AGENTS.md\" \"vite.config.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "node scripts/browser-smoke.mjs",
    "test:fps": "node scripts/fps-bench.mjs",
    "test:perf": "node scripts/fps-bench.mjs",
    "test:visual": "node scripts/visual-golden.mjs",
    "test:soak": "vitest run tests/game/soak.test.ts",
    "test:e2e": "npm run test:smoke",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "three": "^0.172.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/three": "^0.172.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.11",
    "vitest": "^3.0.4"
  }
}
