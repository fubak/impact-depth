{
  "name": "silent-depths-lookdev",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Silent Depths — solo submarine patrol sim (Three.js + deterministic game domain)",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8080",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 8080 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check \"scripts/**/*.mjs\" \"tests/replay.test.ts\" \"tests/e2e/**/*.{mjs,js,ts}\" \"eslint.config.js\" \".prettierrc\" \"package.json\" \"AGENTS.md\" \"vite.config.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "node scripts/browser-smoke.mjs",
    "test:fps": "node scripts/fps-bench.mjs",
    "test:perf": "node scripts/fps-bench.mjs",
    "test:visual": "node scripts/visual-golden.mjs",
    "test:soak": "vitest run tests/game/soak.test.ts",
    "audio:banks": "node scripts/generate-audio-banks.mjs",
    "assets:export": "node scripts/export-procedural-fleet.mjs",
    "assets:import-modern": "node scripts/import-modern-fleet.mjs",
    "assets:validate": "node scripts/validate-assets.mjs",
    "assets:validate:ocean": "node scripts/validate-ocean-assets.mjs",
    "assets:stage:kloofendal": "node scripts/stage-kloofendal-hdr.mjs",
    "test:e2e": "node scripts/e2e-patrol.mjs",
    "test:e2e:ocean": "node scripts/e2e-ocean.mjs",
    "test:e2e:hud": "node scripts/e2e-hud-commands.mjs",
    "test:e2e:assets": "node scripts/e2e-delayed-assets.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "three": "0.185.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@types/three": "0.185.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.11",
    "vitest": "^3.0.4"
  }
}
